<?xml version="1.0"?>
<ruleset name="ogmake">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/.wordpress-org/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.8"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="ogmake-og-images"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="ogmake"/><element value="Ogmake"/></property></properties>
	</rule>
</ruleset>
